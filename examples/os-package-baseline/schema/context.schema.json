{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.codeyourcompliance.com/schemas/os-package-baseline-context-0.1.0.json",
  "title": "OS package baseline evaluation context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "evaluated_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "max_evidence_age_hours": {"type": "number", "minimum": 0},
    "required_packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        },
        "required": ["name", "version"]
      }
    },
    "unexpected_package_mode": {"enum": ["ignore", "fail"]}
  },
  "required": ["evaluated_at_utc", "max_evidence_age_hours", "required_packages", "unexpected_package_mode"]
}
